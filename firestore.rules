rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.token.admin == true; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /public/{doc} {
      allow read: if doc in ['shop','stats'];
      allow write: if owner();
    }
    match /customers/{uid} {
      allow read: if self(uid) || owner();
      allow write: if false; // الكتابة عبر Cloud Functions الموثوقة فقط
    }
    match /bookings/{bookingId} {
      allow read: if owner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /slots/{slotId} { allow read, write: if false; }
    match /queue/{uid} { allow read: if owner(); allow write: if false; }
    match /revenue/{entryId} { allow read: if owner(); allow write: if false; }
  }
}
